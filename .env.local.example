# Copy to .env (already gitignored) and fill in real values.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser or commit. Needed for the Stripe
# webhook and the trial-expiry cron sweep, which run with no user session.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection string (Settings -> Database -> Connection string -> URI).
# Used only by scripts/migrate.mjs to apply supabase/migrations/*.sql.
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Stripe (Developers -> API keys). Test-mode keys are fine to start.
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Set once you've created a webhook endpoint (Developers -> Webhooks) pointing at
# /api/stripe/webhook, or via `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
STRIPE_WEBHOOK_SECRET=whsec_...

# Shared secret checked against the Authorization header on /api/cron/trial-expiry
# so only Vercel Cron (or you, manually) can trigger it.
CRON_SECRET=
