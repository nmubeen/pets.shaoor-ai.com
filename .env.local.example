# Copy to .env (already gitignored) and fill in real values.

# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Never expose to the browser or commit. Needed for the
# Razorpay webhook and the trial-expiry cron sweep, which run with no user
# session.
SUPABASE_SECRET_KEY=sb_secret_...

# Direct Postgres connection string (Settings -> Database -> Connection string -> URI).
# Used only by scripts/migrate.mjs to apply supabase/migrations/*.sql.
DIRECT_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Razorpay (Settings -> API Keys). Test-mode keys work immediately after
# account creation, before KYC/live activation completes.
RAZORPAY_KEY_ID=rzp_test_...
# The key id is also needed client-side (Checkout.js), hence the
# NEXT_PUBLIC_ copy — this one is safe to expose, unlike the secret below.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Set once you've created a webhook (Settings -> Webhooks) pointing at
# /api/razorpay/webhook and selected the subscription.* events.
RAZORPAY_WEBHOOK_SECRET=...

# Shared secret checked against the Authorization header on the /api/cron/*
# routes so only Vercel Cron (or you, manually) can trigger them.
CRON_SECRET=

# Zeptomail (zeptomail.in console -> Mail Agent -> API). Used for every
# email our own code sends (team invites, reminder/expense digests) — not
# Supabase Auth's own emails (confirmation, password reset), which go
# through Supabase's *SMTP* relay instead: Authentication -> Settings ->
# SMTP Settings in the Supabase dashboard, using Zeptomail's SMTP
# credentials (a separate set from the API token below).
ZEPTOMAIL_API_TOKEN=...
EMAIL_FROM_ADDRESS=noreply@pets.shaoor-ai.com
EMAIL_FROM_NAME=Menagerie
# Used to build links inside emails (invite, reminder, reset-password
# redirect). Set this to the real deployed URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
